{
  "expo": {
    "name": "YandN",
    "slug": "YandL",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/yandn.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fff",
        "foregroundImage": "./assets/yandn.jpg",
        "backgroundImage": "./assets/yandn.jpg",
        "monochromeImage": "./assets/yandn.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pos.yandn",
      "permissions": [
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "./plugins/withBluetoothPermissions",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#AF9151",
          "defaultChannel": "low-stock-alerts"
        }
      ]
    ],
    "scheme": "yandn",
    "experiments": {
      "typedRoutes": true
    }
  }
}